{
  "$schema": "https://www.schemastore.org/wrangler.json",
  "name": "planningreport",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
